# Copy to .env (git-ignored). docker compose reads it automatically.
# Required: docker compose up -d fails without DD_API_KEY.

# Datadog > Organization Settings > API Keys
DD_API_KEY=
# Match the site in your Datadog URL: datadoghq.com, datadoghq.eu, us3.datadoghq.com, us5.datadoghq.com, ap1.datadoghq.com
DD_SITE=datadoghq.com
